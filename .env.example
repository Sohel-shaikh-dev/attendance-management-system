# Environment configuration file for Nexus Platform (Attendance Web App)
# Do NOT commit the actual .env file to version control. This is just an example template.

# ─── Core Flask Settings ──────────────────────────────────────────────────────
# Set FLASK_ENV to 'production' to enable secure cookies and disable debug mode.
FLASK_ENV=production

# The secret key used for signing session cookies. 
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_production_key_here

# ─── Database Configuration ───────────────────────────────────────────────────
# Connection string for PostgreSQL
# Format: postgresql://username:password@host:port/database_name
# For platforms like Render or Heroku, this is often provided automatically as DATABASE_URL.
DATABASE_URL=postgresql://postgres:your_password@localhost/attendance_db

# ─── Email / SMTP Configuration ───────────────────────────────────────────────
# Only required if your application sends automated email reports or alerts.
MAIL_SENDER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
